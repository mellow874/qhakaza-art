// ---------------------------------------------------------------------------
// Auth.js adapter tables — shape is dictated by the adapter, not by us.
// ---------------------------------------------------------------------------

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ===========================================================================
// VERA - the evidence and decision-intelligence layer
//
// A structured evidence system, not a report generator. The shape below is
// dictated by six constraints the brief states explicitly. Each is a thing
// this schema must NOT be able to express:
//
//   1. one evidence -> one claim       EvidenceClaim junction
//   2. one artwork  -> one Case        CaseArtwork junction
//   3. one Case     -> one specialist  SpecialistEscalation is many per Case
//   4. fixed evidence categories       lookup TABLES, never enums
//   5. conclusions overwriting earlier CaseVersion is immutable; Contradiction
//                                      rows are preserved, never resolved away
//   6. VERA as a report generator      the graph is the record; a Case is a
//                                      view over it at a moment in time
//
// The reasoning path is reconstructible end to end:
//
//   Source -> Evidence -> (EvidenceClaim) -> Claim -> (ClaimAssessment)
//          -> Assessment -> Gap | Conclusion
// ===========================================================================

/// Where a Case is in its life. An enum, not a lookup: these are workflow
/// states the application reasons about, unlike evidence categories which are
/// taxonomy the business extends.
enum CaseStatus {
  OPEN
  EVIDENCE_COLLECTION
  UNDER_ANALYSIS
  UNDER_REVIEW
  AWAITING_SIGNATURE
  ISSUED
  WITHDRAWN
}

enum ClaimStatus {
  ASSERTED
  SUPPORTED
  CONTESTED
  UNVERIFIED
  WITHDRAWN
}

enum EvidenceStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum GapStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_AS_LIMITATION
}

enum EscalationStatus {
  REQUESTED
  ACKNOWLEDGED
  IN_PROGRESS
  ANSWERED
  DECLINED
}

/// What one link in a provenance chain asserts.
enum ProvenanceLinkKind {
  /// A change of hands we are recording as having happened.
  TRANSFER
  /// Custody is NOT established for this period. A first-class row, because a
  /// chain that omits its unknowns misrepresents itself as complete.
  UNKNOWN_INTERVAL
  /// Asserted by someone, contested by someone else. Both sides stand.
  DISPUTED_TRANSFER
  /// Held by the same party across a period. Recorded for continuity, so a
  /// long uneventful holding is not mistaken for a gap.
  RETAINED
}

enum MethodologyStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

// --- Configurable taxonomy -------------------------------------------------
// TABLES, not enums. The brief is explicit that evidence categories must not
// be hard-coded enums requiring a redeployment to extend.

model EvidenceType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  /// What the category is for, so a researcher picks the right one.
  guidance String?
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  evidence Evidence[]

  @@index([active, ordering])
  @@index([createdById])
}

/// How much weight evidence carries. A table because the scale itself may be
/// revised, and historical Cases must keep the scale they were judged under.
model ReliabilityLevel {
  id     String  @id @default(cuid())
  slug   String  @unique
  label  String
  /// Higher is stronger. For ordering only; never arithmetic.
  rank   Int     @default(0)
  active Boolean @default(true)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  evidence Evidence[]

  @@index([active, rank])
  @@index([createdById])
}

model GapType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  gaps Gap[]

  @@index([active, ordering])
  @@index([createdById])
}

model SpecialistCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  escalations SpecialistEscalation[]

  @@index([active, ordering])
  @@index([createdById])
}

/// What a party is to an artwork or a Case: owner, previous owner, gallery,
/// dealer, institution, specialist. A table so the list can grow.
model PartyRole {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artworkParties ArtworkParty[]
  caseParties    CaseParty[]

  @@index([active, ordering])
  @@index([createdById])
}

// --- Entities in the graph -------------------------------------------------

/// A person or organisation: owner, gallery, dealer, institution, specialist.
///
/// ONE TABLE rather than five near-identical ones. The same gallery can be the
/// seller in one transaction and the lender to an exhibition in another, so the
/// role belongs to the RELATIONSHIP and lives on the junctions.
model Party {
  id           String  @id @default(cuid())
  name         String
  /// Free text: "Gallery", "Estate", "Private collector", "Museum".
  kind         String?
  country      String?
  contactEmail String?
  notes        String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artworkLinks     ArtworkParty[]
  caseLinks        CaseParty[]
  transactionsFrom ProvenanceTransaction[] @relation("TransactionFrom")
  transactionsTo   ProvenanceTransaction[] @relation("TransactionTo")
  escalations      SpecialistEscalation[]
  /// The same organisation as gallery-of-record and as institution. One row,
  /// many roles - which is why Party was one table in the first place.
  representations  ArtistRepresentation[]
  signals          InstitutionalSignal[]

  @@index([name])
  @@index([createdById])
}

model Exhibition {
  id        String    @id @default(cuid())
  title     String
  venue     String?
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artworks ArtworkExhibition[]
  /// The missing edge. Exhibitions existed; only artworks could reach them.
  artists  ArtistExhibition[]

  @@index([title])
  @@index([createdById])
}

model Publication {
  id          String    @id @default(cuid())
  title       String
  author      String?
  publishedOn DateTime?
  reference   String?
  notes       String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artworks ArtworkPublication[]

  @@index([title])
  @@index([createdById])
}

/// One link in a provenance chain.
///
/// DEFECT D3 IN THE AUDIT. This table could only say "A sold to B on a date".
/// A real provenance chain is mostly NOT that: it has periods where custody is
/// unknown, transfers that are asserted but contested, and links that rest on
/// a single unverified source. A table that can only express clean transfers
/// forces the incomplete parts to be left out, and a chain with its gaps
/// silently omitted reads as complete. That is the failure mode that matters,
/// because a collector relies on it.
///
/// The gap is a ROW IN THE CHAIN rather than a separate table, so the chain is
/// still one ordered sequence. Splitting it across two tables would mean
/// reassembling and re-sorting it everywhere it is read.
model ProvenanceTransaction {
  id          String    @id @default(cuid())
  artworkId   String
  fromPartyId String?
  toPartyId   String?
  occurredOn  DateTime?
  amount      Decimal?  @db.Decimal(14, 2)
  currency    String?
  notes       String?

  /// What this link asserts. Existing rows are TRANSFER, which is what they
  /// were when there was nothing else they could be.
  kind ProvenanceLinkKind @default(TRANSFER)

  /// Explicit position in the chain. Dates are frequently unknown or
  /// approximate, so ordering by `occurredOn` alone puts undated links in an
  /// arbitrary place - and for a gap, the absence of a date is the point.
  sequence Int @default(0)

  /// For a gap: the period custody could not be established. Both may be null
  /// when even the boundaries are unknown, which is itself a finding.
  periodStart DateTime?
  periodEnd   DateTime?

  verification     VerificationState @default(UNVERIFIED)
  assertedVia      AssertionOrigin   @default(QHAKAZA_STAFF)
  assertedById     String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  fromParty Party?  @relation("TransactionFrom", fields: [fromPartyId], references: [id], onDelete: SetNull)
  toParty   Party?  @relation("TransactionTo", fields: [toPartyId], references: [id], onDelete: SetNull)

  @@index([artworkId, sequence])
  @@index([artworkId, occurredOn])
  @@index([artworkId, kind])
  @@index([createdById])
}

/// Where evidence came from. Distinct from the evidence itself: one archive is
/// the source of many documents, and a source has its own standing.
model Source {
  id          String    @id @default(cuid())
  name        String
  kind        String?
  sourceDate  DateTime?
  description String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  evidenceLinks EvidenceSource[]
  /// Citations from anywhere else in the platform. Previously only Evidence
  /// could reach a Source - see SourceReference.
  references    SourceReference[]

  @@index([name])
  @@index([createdById])
}

// --- The reasoning chain ---------------------------------------------------

/// One item of evidence.
///
/// Carries every field section 5.2 lists. Two of them - "claim supported" and
/// "Case ID" - are junctions rather than columns, because the brief forbids
/// assuming one evidence supports one claim or belongs to one Case.
model Evidence {
  id String @id @default(cuid())

  /// The work this concerns. Optional: some evidence is about a party or a
  /// transaction rather than an object.
  artworkId String?

  evidenceTypeId String?
  reliabilityId  String?

  description String
  notes       String?

  /// When the source document is dated, as against when we received it.
  sourceDate    DateTime?
  receivedAt    DateTime?
  submittedById String?

  status          EvidenceStatus      @default(RECEIVED)
  confidentiality FileConfidentiality @default(INTERNAL)

  /// Set when this evidence participates in a contradiction. A flag for
  /// filtering; the Contradiction rows are the record.
  contradicted Boolean @default(false)

  reviewerId String?
  reviewedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork      Artwork?          @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  evidenceType EvidenceType?     @relation(fields: [evidenceTypeId], references: [id], onDelete: SetNull)
  reliability  ReliabilityLevel? @relation(fields: [reliabilityId], references: [id], onDelete: SetNull)

  claimLinks             EvidenceClaim[]
  caseLinks              CaseEvidence[]
  sourceLinks            EvidenceSource[]
  contradictionsAsFirst  Contradiction[]  @relation("ContradictionFirst")
  contradictionsAsSecond Contradiction[]  @relation("ContradictionSecond")

  @@index([artworkId, status])
  @@index([evidenceTypeId])
  @@index([status, createdAt])
  @@index([createdById])
}

/// Something asserted about an artwork or a party, which evidence may support
/// or tell against. The unit an assessment is made about.
model Claim {
  id        String  @id @default(cuid())
  artworkId String?

  /// The assertion itself, in plain words.
  statement String
  status    ClaimStatus @default(ASSERTED)
  /// Whether the Case's conclusion turns on this one.
  material  Boolean     @default(false)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  evidenceLinks   EvidenceClaim[]
  assessmentLinks ClaimAssessment[]
  gaps            Gap[]

  @@index([artworkId, status])
  @@index([createdById])
}

/// A reasoned judgement about one or more claims.
///
/// Inference and uncertainty are their own columns rather than prose, because
/// the brief requires evidence, inference and uncertainty to be distinct data
/// concepts rather than three things said in one paragraph.
model Assessment {
  id String @id @default(cuid())

  /// What we conclude.
  conclusion  String
  /// The reasoning from evidence to conclusion - the step that is NOT evidence.
  inference   String?
  /// What remains unknown, and what would change the conclusion.
  uncertainty String?

  methodologyVersionId String?
  assessedById         String?
  assessedAt           DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  methodologyVersion MethodologyVersion? @relation(fields: [methodologyVersionId], references: [id], onDelete: SetNull)

  claimLinks ClaimAssessment[]
  gaps       Gap[]

  @@index([methodologyVersionId])
  @@index([createdById])
}

/// Something missing, weak, or needing a specialist.
model Gap {
  id           String  @id @default(cuid())
  caseId       String?
  artworkId    String?
  claimId      String?
  assessmentId String?

  gapTypeId String?

  description      String
  /// How much it matters to the conclusion.
  materiality      String?
  responsibleParty String?
  actionRequired   String?

  identifiedAt DateTime  @default(now())
  dueAt        DateTime?
  status       GapStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case       IntelligenceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  artwork    Artwork?          @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  claim      Claim?            @relation(fields: [claimId], references: [id], onDelete: SetNull)
  assessment Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  gapType    GapType?          @relation(fields: [gapTypeId], references: [id], onDelete: SetNull)

  @@index([caseId, status])
  @@index([artworkId])
  @@index([status, dueAt])
  @@index([createdById])
}

/// Two items of evidence that cannot both be right.
///
/// NEVER OVERWRITTEN BY LATER EVIDENCE. The brief is explicit that
/// contradictions are preserved. Resolving one records HOW it was resolved and
/// leaves both sides standing, because which evidence was set aside, and why,
/// is part of the institutional record.
model Contradiction {
  id     String  @id @default(cuid())
  caseId String?

  firstEvidenceId  String
  secondEvidenceId String

  description String
  materiality String?

  /// How it was resolved, if it was. Both sides remain regardless.
  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case           IntelligenceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  firstEvidence  Evidence          @relation("ContradictionFirst", fields: [firstEvidenceId], references: [id], onDelete: Cascade)
  secondEvidence Evidence          @relation("ContradictionSecond", fields: [secondEvidenceId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([firstEvidenceId])
  @@index([secondEvidenceId])
  @@index([createdById])
}

/// A question referred to a specialist. Many per Case, by design.
model SpecialistEscalation {
  id        String  @id @default(cuid())
  caseId    String?
  artworkId String?

  categoryId     String?
  specialistId   String?
  specialistName String?

  issue             String
  reason            String?
  documentsSupplied String?

  requestedAt DateTime         @default(now())
  status      EscalationStatus @default(REQUESTED)

  response             String?
  conclusion           String?
  outstandingQuestions String?
  completedAt          DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case       IntelligenceCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  artwork    Artwork?            @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  category   SpecialistCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specialist Party?              @relation(fields: [specialistId], references: [id], onDelete: SetNull)

  @@index([caseId, status])
  @@index([categoryId])
  @@index([createdById])
}

// --- Methodology and accountability ----------------------------------------

/// The version of the method a Case was prepared under.
///
/// Historical Cases stay linked to the version they used. Revising the method
/// must never silently restate what an earlier Case claimed to have done.
model MethodologyVersion {
  id            String            @id @default(cuid())
  versionNumber String            @unique
  effectiveFrom DateTime
  status        MethodologyStatus @default(DRAFT)
  description   String?
  approvedBy    String?
  changeNotes   String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  assessments          Assessment[]
  caseVersions         CaseVersion[]
  readinessAssessments ReadinessAssessment[]

  @@index([status, effectiveFrom])
  @@index([createdById])
}

/// A Collector Intelligence Case.
///
/// The living record. What was ISSUED at any point is a CaseVersion, which is
/// immutable - so this row may move on while every version it ever issued
/// stands exactly as it was.
model IntelligenceCase {
  id        String @id @default(cuid())
  /// Human-facing identifier, e.g. QAC-2026-014.
  reference String @unique

  title String
  /// What the Case covers, and deliberately what it does not.
  scope String?

  /// Who it was prepared for. Optional: a Case can be opened before a
  /// collector is attached to it.
  collectorIntakeId String?

  status CaseStatus @default(OPEN)

  openedAt DateTime  @default(now())
  issuedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  collectorIntake CollectorIntake? @relation(fields: [collectorIntakeId], references: [id], onDelete: SetNull)

  artworks       CaseArtwork[]
  evidenceLinks  CaseEvidence[]
  parties        CaseParty[]
  gaps           Gap[]
  contradictions Contradiction[]
  escalations    SpecialistEscalation[]
  versions       CaseVersion[]

  @@index([status, openedAt])
  @@index([collectorIntakeId])
  @@index([createdById])
}

/// One issued version of a Case. IMMUTABLE ONCE ISSUED.
///
/// Generating a revision INSERTS a new row. Nothing updates an issued version,
/// which is what makes "a revised Case never destroys a previously issued one"
/// true at the storage layer rather than by convention.
///
/// The narrative fields are a SNAPSHOT. The graph moves on; what was said on
/// the day must not move with it.
model CaseVersion {
  id            String @id @default(cuid())
  caseId        String
  /// 1, 2, 3... unique within the Case.
  versionNumber Int

  /// The prose as issued.
  summary            String?
  decisionAssessment String?
  uncertainties      String?
  limitations        String?

  methodologyVersionId String?

  /// Named accountability, per section 5.7.
  accountableName  String?
  accountableRole  String?
  accountableAt    DateTime?
  /// How the sign-off was made: typed name, uploaded signature, external.
  signatureMethod  String?
  signatureAssetId String?

  /// Recorded where they differ from the accountable party.
  preparedByName String?
  reviewedByName String?

  issuedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case               IntelligenceCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion? @relation(fields: [methodologyVersionId], references: [id], onDelete: SetNull)

  @@unique([caseId, versionNumber])
  @@index([caseId, issuedAt])
  @@index([createdById])
}

// --- Junctions -------------------------------------------------------------
// Every one of these exists because the brief forbids the one-to-one it would
// otherwise have been.

/// One Case may cover several works; one work may appear in several Cases.
model CaseArtwork {
  id        String  @id @default(cuid())
  caseId    String
  artworkId String
  /// Why this work is in this Case.
  role      String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case    IntelligenceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  artwork Artwork          @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([caseId, artworkId])
  @@index([artworkId])
  @@index([createdById])
}

/// One item of evidence may be reviewed by several Cases.
model CaseEvidence {
  id         String @id @default(cuid())
  caseId     String
  evidenceId String

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case     IntelligenceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([caseId, evidenceId])
  @@index([evidenceId])
  @@index([createdById])
}

/// THE constraint from section 5.9: one evidence supports many claims, and one
/// claim rests on many evidence items.
model EvidenceClaim {
  id         String @id @default(cuid())
  evidenceId String
  claimId    String

  /// Whether this evidence supports the claim or tells against it.
  supports Boolean @default(true)
  weight   String?
  note     String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, claimId])
  @@index([claimId])
  @@index([createdById])
}

/// An assessment may weigh several claims at once.
model ClaimAssessment {
  id           String @id @default(cuid())
  claimId      String
  assessmentId String

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  claim      Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([claimId, assessmentId])
  @@index([assessmentId])
  @@index([createdById])
}

/// A party's role is a property of the relationship, not of the party.
model ArtworkParty {
  id        String  @id @default(cuid())
  artworkId String
  partyId   String
  roleId    String?

  fromDate DateTime?
  toDate   DateTime?
  note     String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  party   Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role    PartyRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([partyId])
  @@index([createdById])
}

model CaseParty {
  id      String  @id @default(cuid())
  caseId  String
  partyId String
  roleId  String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  case  IntelligenceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  party Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role  PartyRole?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([caseId, partyId, roleId])
  @@index([partyId])
  @@index([createdById])
}

/// One document can come from several sources; one archive yields many.
model EvidenceSource {
  id         String @id @default(cuid())
  evidenceId String
  sourceId   String

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, sourceId])
  @@index([sourceId])
  @@index([createdById])
}

model ArtworkExhibition {
  id           String  @id @default(cuid())
  artworkId    String
  exhibitionId String
  note         String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork    Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@unique([artworkId, exhibitionId])
  @@index([exhibitionId])
  @@index([createdById])
}

model ArtworkPublication {
  id            String  @id @default(cuid())
  artworkId     String
  publicationId String
  page          String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork     Artwork     @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([artworkId, publicationId])
  @@index([publicationId])
  @@index([createdById])
}

// ===========================================================================
// Content surfaces
//
// Everything here exists so the words on the public sites can change without a
// deployment. Each was previously a TypeScript file that only a developer
// could edit, which is the thing section 18-20 asks us to stop.
//
// DEMO CONTENT IS MARKED IN THE DATA, not just in a comment. Every row carries
// `isDemo`, the surfaces render a visible notice while any is present, and one
// UPDATE clears the lot. Placeholder text that cannot be told apart from real
// content is how a demo becomes a liability.
// ===========================================================================

model FaqCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  ordering Int     @default(0)
  active   Boolean @default(true)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  items FaqItem[]

  @@index([active, ordering])
  @@index([createdById])
}

model FaqItem {
  id         String @id @default(cuid())
  categoryId String

  question String
  answer   String

  ordering  Int     @default(0)
  published Boolean @default(false)
  /// Written by the developers to fill the page for a demo. Not Qhakaza's
  /// words, and the site says so while any remain.
  isDemo    Boolean @default(false)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, ordering])
  @@index([published])
  @@index([createdById])
}

/// A Briefing, managed from the Command Center.
///
/// Distinct from the existing `NewsArticle`, which is retained: that model was
/// built to an earlier brief and holds no rows the site reads. This one carries
/// the fields section 19 names - subtitle, author, cover image, sources and
/// related Briefings - and is what the site now reads.
model Briefing {
  id   String @id @default(cuid())
  slug String @unique

  title    String
  subtitle String?
  author   String?
  category String?

  /// The full text. Markdown-ish plain text; rendered as paragraphs.
  body    String?
  /// The summary shown in listings. Supplied for every Briefing from the start.
  excerpt String

  coverImageUrl String?
  /// Where the claims come from. A Briefing making market claims without
  /// sources is the thing VERA exists to argue against.
  sources       String?

  publishedAt DateTime?
  status      ArticleStatus @default(DRAFT)
  isDemo      Boolean       @default(false)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  relatedTo   BriefingRelation[] @relation("BriefingFrom")
  relatedFrom BriefingRelation[] @relation("BriefingTo")

  @@index([status, publishedAt])
  @@index([createdById])
}

/// "Related Briefings", per section 19. A junction because the relationship is
/// many-to-many and deliberately not symmetric: A may point at B without B
/// pointing back.
model BriefingRelation {
  id     String @id @default(cuid())
  fromId String
  toId   String

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  from Briefing @relation("BriefingFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Briefing @relation("BriefingTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@index([createdById])
}

/// A published version of a legal document.
///
/// PUBLISHING A NEW VERSION NEVER DELETES A PRIOR ONE. Section 20 requires
/// previous-version retention, and for a document people agreed to that is not
/// a nicety: you must be able to show what someone accepted on the day they
/// accepted it. There is no delete path anywhere for this table.
model LegalDocumentVersion {
  id String @id @default(cuid())

  /// "TERMS" or "PRIVACY". A string rather than an enum so a third document
  /// does not need a migration.
  documentKey String

  versionNumber String
  effectiveFrom DateTime

  title String
  body  String

  status ArticleStatus @default(DRAFT)
  isDemo Boolean       @default(false)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  @@unique([documentKey, versionNumber])
  @@index([documentKey, status, effectiveFrom])
  @@index([createdById])
}

// ===========================================================================
// VISIBILITY AND RELEASE
//
// Approval is not publication. Publication to one collector is not publication
// to all. Neither is publication to the world. Those are four different facts
// and the schema keeps them apart.
//
// THE FOUR QUESTIONS the brief requires to be answerable about any record are
// answered by rows, never inferred from a status column:
//
//   Where is this visible?   ArtworkRelease.tier
//   Who may see it?          Audience -> AudienceMember -> Membership
//   Why may they see it?     ArtworkRelease.reason, .releasedById, .releasedAt
//   Which version?           ArtworkRelease.versionLabel
//
// A work reaches a collector only if an un-revoked release exists to an
// audience that collector belongs to, AND the artist granted the matching
// permission. Both conditions live in RLS, not in a query someone must
// remember to write.
// ===========================================================================

/// Where a record is visible. The four contexts from the brief.
enum VisibilityTier {
  /// The submitting artist and Qhakaza internally.
  ARTIST_WORKING_RECORD
  /// Qhakaza only, while evidence and presentation are reviewed.
  INTERNAL_REVIEW
  /// An approved, collector-safe version released to a specific audience.
  PRIVATE_COLLECTOR_PROJECTION
  /// Separately authorised editorial or brand use. Never inventory.
  PUBLIC_EDITORIAL
}

/// What an artist has allowed Qhakaza to do with their material.
///
/// STORING SOMETHING AND BEING ALLOWED TO USE IT ARE DIFFERENT MATTERS. A work
/// without PUBLISH_PUBLICLY can never enter a public editorial state however
/// many people approve it - enforced in RLS, not by convention.
enum PermissionKind {
  STORE_MATERIAL

  /// Permission to USE the material in internal assessment: to reason from it,
  /// cite it in a Case, and let it inform a recommendation.
  ///
  /// Distinct from STORE_MATERIAL on purpose. Storing is custody; using is
  /// application, and they are separable. An artist may hand over a contract
  /// so it is on file for reference and not expect it weighed in an assessment
  /// they cannot see. Collapsing the two would mean the narrower intention had
  /// no way to be expressed, which is the same failure as having no permission
  /// model at all.
  USE_INTERNALLY

  SHARE_PRIVATELY_WITH_COLLECTORS
  USE_IN_PRIVATE_BRIEF
  PRESENT_TO_PARTNERS
  PUBLISH_PUBLICLY
  PUBLISH_ARTIST_STORY
  RETAIN_DOCUMENTATION
}

/// A named group a work can be released to.
///
/// A TABLE OF TYPES, not an enum, because the brief requires the list to grow.
/// Private brief, partner programme and private experience exist now as
/// STRUCTURAL PLACEHOLDERS - the products behind them are a later phase.
model AudienceType {
  id            String  @id @default(cuid())
  slug          String  @unique
  label         String
  /// False where the type exists structurally but the product does not yet.
  isLiveProduct Boolean @default(false)
  active        Boolean @default(true)
  ordering      Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  audiences Audience[]

  @@index([active, ordering])
  @@index([createdById])
}

model Audience {
  id     String  @id @default(cuid())
  typeId String?

  name        String
  description String?
  /// Retired audiences stop receiving releases without breaking history.
  active      Boolean @default(true)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  type     AudienceType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  members  AudienceMember[]
  releases ArtworkRelease[]

  @@index([active])
  @@index([typeId])
  @@index([createdById])
}

/// Who is in an audience.
///
/// Membership, not User: a collector's standing with Qhakaza is what grants
/// sight of a work, and it can lapse or be revoked independently of the account.
model AudienceMember {
  id           String @id @default(cuid())
  audienceId   String
  membershipId String

  addedById String?
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  audience   Audience   @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([audienceId, membershipId])
  @@index([membershipId, removedAt])
  @@index([createdById])
}

/// The act of releasing a work to an audience, at a tier.
///
/// APPEND-MOSTLY. Withdrawing sets revokedAt rather than deleting, because who
/// could see what, and when, is provenance and feeds VERA.
model ArtworkRelease {
  id         String @id @default(cuid())
  artworkId  String
  audienceId String

  tier VisibilityTier @default(PRIVATE_COLLECTOR_PROJECTION)

  /// Why this audience may see it. Shown to staff, never to the collector.
  reason       String?
  /// Which projection of the work this release refers to.
  versionLabel String?

  releasedById String?
  releasedAt   DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork  Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@index([artworkId, revokedAt])
  @@index([audienceId, revokedAt])
  @@index([tier, revokedAt])
  @@index([createdById])
}

/// An artist's explicit permission, per artwork or for the artist generally.
///
/// `artworkId` null means the permission covers the artist's material as a
/// whole. A work-specific row wins over a general one.
/// What the artist has allowed Qhakaza to do, and what they have refused.
///
/// THE CONFLICT RULE: MORE RESTRICTIVE WINS.
///
/// A row with `artworkId` set applies to that work; a row with it null applies
/// to everything the artist has. When both exist for the same kind, the
/// permission holds only if EVERY applicable row grants it. One denial
/// anywhere is a denial.
///
/// This was defect D6 in the Phase 0 audit and it was live: the check read
/// `granted = true AND (artworkId IS NULL OR artworkId = <work>)`, an EXISTS
/// over granting rows. An artist who permitted private sharing generally and
/// then denied it for one particular work still had that work shown, because
/// the general grant satisfied the EXISTS on its own. The rule was not merely
/// missing - it was inverted, and it failed in the direction that shows work
/// the artist asked to be held back.
///
/// The rule is now enforced in `qhakaza_permission_granted()` and every
/// visibility path goes through it. See 20260820000200_permission_conflict.
///
/// An EXPIRED grant counts as no grant rather than as a denial: it withdraws
/// permission without asserting that the artist refused.
model ArtistPermission {
  id        String  @id @default(cuid())
  artistId  String
  artworkId String?

  kind    PermissionKind
  granted Boolean

  /// What the artist actually did to confirm it, in their own record.
  confirmingAction String?
  decidedAt        DateTime @default(now())

  /// A limit the artist placed on the grant, in their words: "South Africa
  /// only", "not the 2019 series". Recorded and shown to staff; it is NOT
  /// machine-enforced, and the admin surface says so rather than implying a
  /// constraint the database does not apply.
  scopeNote String?

  /// When the grant lapses. A permission with no expiry does not expire; one
  /// that has passed its expiry is treated as absent, not as a denial.
  expiresAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist  Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artwork Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([artistId, artworkId, kind])
  @@index([artworkId, kind, granted])
  @@index([createdById])
}

// ===========================================================================
// COLLECTOR PROFILE AND MATCHING
//
// Qhakaza matches approved work to collectors by genre and collecting
// preference. Those preferences already existed - scattered across the intake
// form and the Private Note, keyed by email, attached to no one. This gives
// them a home against the membership so they can be used.
//
// THE SYSTEM SUGGESTS. IT NEVER RELEASES. Nothing here creates an
// ArtworkRelease; suggestions are ranked candidates for an admin to accept or
// ignore, and the release remains a deliberate human act.
// ===========================================================================

/// A collector's private record of preference and relationship intelligence.
///
/// One per membership. Populated from the intake and the Private Note today,
/// and from the conversational agent when it replaces the form; extended into
/// the fuller Collecting Direction in the collector-platform phase.
model CollectorProfile {
  id           String @id @default(cuid())
  membershipId String @unique

  /// What they collect. The matchable fields.
  mediums String[]
  regions String[]
  themes  String[]

  /// How they collect. Read by a person, not by the ranker.
  motivations      String?
  budgetLogic      String?
  acquisitionPace  String?
  collectingIntent String?
  /// How settled they are in their own judgement, in Qhakaza's words.
  confidenceLevel  String?
  confidenceGaps   String?

  /// Where this understanding came from: "intake", "private-note",
  /// "conversation", "advisor". Free text because the list will grow.
  sourcedFrom String?
  /// Anything an advisor wants remembered that has no field of its own.
  notes       String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([createdById])
}

/// A ranked suggestion an admin has been shown.
///
/// Recorded rather than computed and forgotten, for two reasons: an admin
/// should see what was already suggested and dismissed, and knowing which
/// suggestions were acted on is the only way to tell whether the ranking is
/// any good.
model MatchSuggestion {
  id           String @id @default(cuid())
  artworkId    String
  membershipId String

  /// Higher is a closer fit. Ordering only - never shown as a percentage,
  /// because it is not a measurement of anything.
  score     Int     @default(0)
  /// Why this pairing surfaced, in words an advisor can weigh.
  rationale String?

  /// Set when an admin acts on it. A suggestion is never a release.
  actedOn   Boolean   @default(false)
  dismissed Boolean   @default(false)
  decidedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork    Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([artworkId, membershipId])
  @@index([membershipId, score])
  @@index([artworkId, score])
  @@index([createdById])
}

// ===========================================================================
// THE ARTIST INTELLIGENCE PLATFORM
//
// The source records VERA will later operate on. Depth here, not breadth
// elsewhere.
//
// THREE RULES SHAPE EVERYTHING BELOW, and they are worth stating once rather
// than repeating on every model.
//
//  1. CHILD TABLES, NEVER BLOBS. An exhibition history in a JSON column is
//     unqueryable, unverifiable and cannot carry its own source. Every
//     repeating fact is a row.
//
//  2. WHAT IS TRUE IS SEPARATE FROM WHO SAID IT. Every asserted fact carries
//     both `verification` (how well established) and `assertedVia`/`assertedById`
//     (whose account it is). Collapsing the two is how "the artist told us" and
//     "we confirmed it" become indistinguishable six months later.
//
//  3. NOTHING HERE DUPLICATES VERA. Exhibitions, publications, parties and
//     sources already exist as first-class entities. These tables CONNECT an
//     artist to them; they do not re-declare them.
// ===========================================================================

/// How well established an asserted fact is.
///
/// Deliberately NOT a boolean. "We have not looked" and "we looked and could
/// not confirm" are different states, and an intelligence product that cannot
/// tell them apart is misleading in the direction that matters.
enum VerificationState {
  /// Recorded, nothing done about it yet.
  UNVERIFIED
  /// The artist says so. An honest starting point, not a finding.
  ARTIST_DECLARED
  /// A document on file supports it. See the linked DocumentLink rows.
  DOCUMENT_ON_FILE
  /// Confirmed against a source independent of the artist.
  INDEPENDENTLY_VERIFIED
  /// Checked, and the check failed to establish it either way.
  UNABLE_TO_VERIFY
  /// Something credible contradicts it. Preserved, never quietly dropped.
  DISPUTED
}

/// Whose account a fact is. Orthogonal to how well verified it is.
enum AssertionOrigin {
  ARTIST
  QHAKAZA_STAFF
  DOCUMENT
  THIRD_PARTY
}

// --- Configurable lists ----------------------------------------------------
//
// Every one of these is a table rather than an enum because the brief requires
// Qhakaza to extend the vocabulary without a developer and a deployment. They
// share a shape: slug, label, active, ordering.

/// Media an artist works in. Referenced by artists AND intended to replace the
/// free-text `Artwork.medium` over time - that column stays for now so nothing
/// breaks, but new capture should use this list.
model Medium {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  /// A grouping for presentation: "Painting", "Photography", "Sculpture".
  family   String?
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artists ArtistMedium[]

  @@index([active, ordering])
  @@index([createdById])
}

/// Solo, group, biennale, art fair, institutional survey. The distinction
/// carries real weight in an assessment, so it is not free text.
model ExhibitionType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  guidance String?
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artistExhibitions ArtistExhibition[]

  @@index([active, ordering])
  @@index([createdById])
}

/// Kinds of institutional recognition: acquisition, residency, prize,
/// commission, grant, collection inclusion.
model SignalType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  guidance String?
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  signals InstitutionalSignal[]

  @@index([active, ordering])
  @@index([createdById])
}

/// Sections of a curriculum vitae: education, teaching, residency, award,
/// selected press, public collection.
model CvEntryType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  entries CvEntry[]

  @@index([active, ordering])
  @@index([createdById])
}

/// The nature of a representation arrangement: primary gallery, secondary
/// market, estate, agent, self-represented.
model RepresentationType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  active   Boolean @default(true)
  ordering Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  representations ArtistRepresentation[]

  @@index([active, ordering])
  @@index([createdById])
}

/// WHAT A STORED FILE IS: certificate of authenticity, condition report,
/// exhibition catalogue, invoice, correspondence, identity document.
///
/// Its absence was defect D2 in the Phase 0 audit. A file table that records
/// size and MIME type but not what the document IS cannot answer the only
/// question anyone asks of it.
model DocumentType {
  id                     String              @id @default(cuid())
  slug                   String              @unique
  label                  String
  guidance               String?
  /// The confidentiality a document of this type should default to. A
  /// certificate and an identity document are not the same exposure.
  defaultConfidentiality FileConfidentiality @default(INTERNAL)
  active                 Boolean             @default(true)
  ordering               Int                 @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  assets MediaAsset[]

  @@index([active, ordering])
  @@index([createdById])
}

/// A dimension an artist is assessed on for market readiness.
///
/// The criteria themselves are Qhakaza's proprietary framework and are
/// configurable: the platform stores and applies them, and does not define
/// them. No criterion is seeded by this migration for that reason.
model ReadinessCriterion {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  /// What a reviewer should be looking for. Shown beside the rating.
  guidance String?
  /// Presentation order only. Never summed, never averaged - a readiness
  /// score computed by a developer's arithmetic would be an invented finding.
  ordering Int     @default(0)
  active   Boolean @default(true)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  ratings ReadinessRating[]

  @@index([active, ordering])
  @@index([createdById])
}

// --- The artist record, in depth -------------------------------------------

/// What an artist works in, and what they lead with.
model ArtistMedium {
  id       String  @id @default(cuid())
  artistId String
  mediumId String
  /// A primary medium is what the artist is known for; others are secondary.
  primary  Boolean @default(false)
  note     String?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  medium Medium @relation(fields: [mediumId], references: [id], onDelete: Restrict)

  @@unique([artistId, mediumId])
  @@index([artistId, primary])
  @@index([createdById])
}

/// An artist's showing history.
///
/// JOINS THE EXISTING `Exhibition` TABLE. The audit's central finding was that
/// exhibitions already existed but only artworks could reach them; this is the
/// missing edge, not a second exhibition table.
model ArtistExhibition {
  id           String  @id @default(cuid())
  artistId     String
  exhibitionId String
  typeId       String?

  /// The artist's part in it: exhibiting artist, featured, collaborator.
  role      String?
  curator   String?
  /// Where the catalogue or listing can be found, in words.
  reference String?

  verification     VerificationState @default(UNVERIFIED)
  assertedVia      AssertionOrigin   @default(ARTIST)
  assertedById     String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist     Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  exhibition Exhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  type       ExhibitionType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@unique([artistId, exhibitionId])
  @@index([artistId, verification])
  @@index([createdById])
}

/// Who represents this artist, where, and for how long.
///
/// The gallery is a `Party` - the same row that may appear as a seller in a
/// provenance chain. One organisation, one record, many roles.
model ArtistRepresentation {
  id       String  @id @default(cuid())
  artistId String
  partyId  String
  typeId   String?

  /// Where the arrangement applies. Free text: "South Africa", "worldwide
  /// excluding North America". Territories are negotiated, not enumerable.
  territory String?
  startDate DateTime?
  endDate   DateTime?
  /// Denormalised from endDate for the common query, and kept honest by the
  /// application: an arrangement with no end date is not automatically current.
  current   Boolean   @default(true)
  exclusive Boolean?
  note      String?

  verification     VerificationState @default(UNVERIFIED)
  assertedVia      AssertionOrigin   @default(ARTIST)
  assertedById     String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist Artist              @relation(fields: [artistId], references: [id], onDelete: Cascade)
  party  Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  type   RepresentationType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([artistId, current])
  @@index([partyId])
  @@index([createdById])
}

/// One line of a curriculum vitae.
///
/// Structured rather than an uploaded PDF, because a CV that cannot be queried
/// cannot be assessed. The uploaded PDF is still welcome - it attaches as a
/// document and becomes the source that verifies these rows.
model CvEntry {
  id       String  @id @default(cuid())
  artistId String
  typeId   String?

  title        String
  organisation String?
  location     String?
  /// Years rather than dates: a CV says "2019", not "14 March 2019".
  startYear    Int?
  endYear      Int?
  detail       String?
  ordering     Int     @default(0)

  verification     VerificationState @default(UNVERIFIED)
  assertedVia      AssertionOrigin   @default(ARTIST)
  assertedById     String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  type   CvEntryType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([artistId, ordering])
  @@index([artistId, verification])
  @@index([createdById])
}

/// Recognition by an institution: an acquisition, a residency, a prize, a
/// commission, inclusion in a public collection.
///
/// These are the strongest signals in the record and the ones most worth
/// verifying, which is why the institution is a `Party` rather than a string.
model InstitutionalSignal {
  id           String  @id @default(cuid())
  artistId     String
  signalTypeId String?
  /// The institution, when it is one we hold a record for.
  partyId      String?
  /// Its name as stated, kept even when no Party row exists yet.
  institution  String?

  description String
  occurredOn  DateTime?
  year        Int?

  verification     VerificationState @default(UNVERIFIED)
  assertedVia      AssertionOrigin   @default(ARTIST)
  assertedById     String?
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist     Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  signalType SignalType? @relation(fields: [signalTypeId], references: [id], onDelete: SetNull)
  party      Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([artistId, verification])
  @@index([partyId])
  @@index([createdById])
}

/// An artist's presence elsewhere: website, portfolio, gallery page, press.
///
/// Replaces the `Artist.socials` JSON blob, which could not be verified, could
/// not be typed and could not carry a source. That column stays for now so
/// existing reads keep working; new capture writes here.
model ArtistLink {
  id       String @id @default(cuid())
  artistId String

  /// "Website", "Instagram", "Gallery page", "Press". Free text on purpose -
  /// platforms come and go faster than a configurable list is worth.
  kind  String
  label String?
  url   String

  verification VerificationState @default(UNVERIFIED)
  checkedAt    DateTime?

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([createdById])
}

// --- Append-only history ---------------------------------------------------
//
// The three tables below are INSERT-only at the grant level as well as the
// policy level, following the pattern established in
// 20260813001100_append_only_hardening. A price that can be edited is not a
// pricing history, and an assessment that can be rewritten is not a record of
// what was decided.

/// A declared value, at a point in time, by someone named.
///
/// Defect D4 in the audit: `Artwork.price` is one column, so changing a price
/// destroyed the previous one. Every declaration now survives. `Artwork.price`
/// remains as the CURRENT figure for existing reads; this is the history
/// behind it.
///
/// "Declared" is doing real work in the name. This is what was asked or
/// stated - it is NOT a valuation, and nothing in the platform should present
/// it as one.
model DeclaredPrice {
  id        String  @id @default(cuid())
  artistId  String?
  artworkId String?

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("ZAR")

  /// Why this figure: "artist's asking price", "gallery retail", "insurance".
  basis String?
  note  String?

  declaredOn   DateTime        @default(now())
  declaredVia  AssertionOrigin @default(ARTIST)
  declaredById String?

  /// True for the figure currently in force. Set by the application when a
  /// newer declaration arrives; never a reason to edit the older row.
  current Boolean @default(true)

  createdAt   DateTime @default(now()) @map("created_date")
  createdById String?  @map("created_by_id")

  artist  Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artwork Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId, current])
  @@index([artistId, declaredOn])
  @@index([createdById])
}

/// One assessment of an artist against the readiness framework, on one date,
/// by one named reviewer.
///
/// NEVER VISIBLE TO THE ARTIST. Confirmed as absolute by Qhakaza. This is not
/// enforced by hope: there is no `artist` grant on this table or on
/// ReadinessRating in the RLS matrix, so an artist session cannot read a row
/// even if a query asks for one.
model ReadinessAssessment {
  id       String @id @default(cuid())
  artistId String

  /// Which version of the framework this was judged under, so a historical
  /// assessment keeps the criteria it was actually made against.
  methodologyVersionId String?

  /// The reviewer's overall position, in their own words. Deliberately text
  /// and not a score - see ReadinessCriterion.ordering.
  summary        String?
  /// A recommendation, not a decision. Approval remains a separate act.
  recommendation String?

  assessedById String?
  assessedAt   DateTime @default(now())

  /// A superseding assessment points back at what it replaces. The replaced
  /// row is untouched.
  supersedesId String? @unique

  createdAt   DateTime @default(now()) @map("created_date")
  createdById String?  @map("created_by_id")

  artist             Artist               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion?  @relation(fields: [methodologyVersionId], references: [id], onDelete: SetNull)
  supersedes         ReadinessAssessment? @relation("ReadinessSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       ReadinessAssessment? @relation("ReadinessSupersedes")
  ratings            ReadinessRating[]

  @@index([artistId, assessedAt])
  @@index([createdById])
}

/// How one criterion was rated within one assessment.
model ReadinessRating {
  id           String @id @default(cuid())
  assessmentId String
  criterionId  String

  /// The rating as a label, from the criterion's own vocabulary. Not a number:
  /// numbers invite averaging, and an averaged readiness score is a finding
  /// nobody made.
  rating   String?
  evidence String?
  concern  String?

  createdAt   DateTime @default(now()) @map("created_date")
  createdById String?  @map("created_by_id")

  assessment ReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion  ReadinessCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, criterionId])
  @@index([criterionId])
  @@index([createdById])
}

/// Every change to an artist or artwork record, field by field.
///
/// `AuditLog` records that an action happened. This records what a specific
/// field held before and after, which is the question asked when a record is
/// challenged: not "was it edited" but "what did it say when we relied on it".
model RecordChange {
  id String @id @default(cuid())

  subjectType String
  subjectId   String
  /// Dotted for child rows: "cvEntry.title", "representation.territory".
  field       String

  previousValue String?
  newValue      String?

  changedById String?
  changedRole Role?
  changedAt   DateTime @default(now())
  reason      String?

  createdAt   DateTime @default(now()) @map("created_date")
  createdById String?  @map("created_by_id")

  @@index([subjectType, subjectId, changedAt])
  @@index([changedById, changedAt])
  @@index([createdById])
}

// --- Documents and sources -------------------------------------------------

/// A stored file's attachment to a record. Many per file.
///
/// DEFECT D1 IN THE AUDIT. `MediaAsset` addressed exactly one owner through
/// `subjectType`/`subjectId`, so one document could belong to one record. The
/// brief's own example breaks that: an exhibition catalogue evidences BOTH the
/// artist's exhibition history AND a work's provenance. Under the old shape
/// that meant uploading the same PDF twice and hoping the two copies stayed
/// consistent - which is the duplication this phase exists to prevent.
///
/// The columns on MediaAsset stay and are backfilled into this table as the
/// primary link, so nothing that reads them today breaks.
model DocumentLink {
  id           String @id @default(cuid())
  mediaAssetId String

  /// "Artist", "Artwork", "ArtistExhibition", "ProvenanceTransaction", ...
  /// A string for the same reason MediaAsset.subjectType is one: VERA adds
  /// subjects, and a new one should not need a migration.
  subjectType String
  subjectId   String

  /// Why the document is attached HERE, which may differ per link. The same
  /// catalogue is "exhibition record" on one and "provenance support" on
  /// another.
  role String?

  /// The link created by backfill from MediaAsset's own columns. Exactly one
  /// per asset; the rest are additional attachments.
  primaryLink Boolean @default(false)

  /// Withdrawn by the artist or by staff. NOT a delete: a claim that was
  /// made and later retracted is itself part of the record, and a row that
  /// can vanish cannot be reconciled against an assessment that relied on
  /// it. Every read of this table filters on it.
  removedAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@index([createdById])
}

/// A record citing the source that supports it.
///
/// DEFECT D5 IN THE AUDIT, and the one the brief calls "the VERA hook - build
/// it properly". `Source` existed, but only `Evidence` could reach it, so
/// nothing on an artist or an artwork could say where it came from. Every
/// assertion in the platform can now point at what stands behind it.
///
/// Polymorphic for the same reason as DocumentLink, and additionally because
/// the interesting citation is often on a CHILD row - this exhibition, this
/// provenance link - not on the artist as a whole.
model SourceReference {
  id       String @id @default(cuid())
  sourceId String

  subjectType String
  subjectId   String
  /// Which assertion on that record the source supports. Null means the
  /// record as a whole.
  field       String?

  /// Where in the source: page, catalogue number, URL, shelf mark.
  locator String?
  /// What the source actually says, quoted. Kept because a source that has
  /// moved or gone offline still has to be answerable for.
  extract String?

  /// How this citation was reached, distinct from the source's own standing.
  assertedVia  AssertionOrigin @default(QHAKAZA_STAFF)
  assertedById String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
  @@index([sourceId])
  @@index([createdById])
}

/// A fixed-window request counter, for rate limiting.
///
/// IN THE DATABASE RATHER THAN IN MEMORY, because the apps run on Vercel where
/// each serverless instance has its own memory. An in-memory limiter there
/// counts a fraction of the requests and lets the rest through, which is worse
/// than none: it reads as a control and is not one.
///
/// FIXED WINDOW, not sliding, and worth being honest about. A caller can send
/// the limit twice across a window boundary. That is an acceptable trade for a
/// counter that costs one upsert and needs no background sweep, given what
/// this protects: public forms against flooding, not an API against a
/// determined attacker.
///
/// Rows are written with no actor, from `asSystem` - rate limiting happens
/// before anyone is authenticated, which is exactly when it matters.
model RateLimitCounter {
  id String @id @default(cuid())

  /// What is being limited and by whom: "contact:203.0.113.5". The value is
  /// hashed at the call site where it carries personal data.
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  @@unique([bucket, windowStart])
  @@index([windowStart])
}

// Qhakaza Art Collective — the single shared database.
//
// One database, three applications: Vera (public artist site), Collector
// Platform (private, invite-only) and Command Center (admin hub). Every app
// reaches this schema through @qhakaza/shared-db and nothing else.
//
// FIELD CONVENTION
// Every core entity carries the four standard fields. The Prisma property names
// stay camelCase (TypeScript idiom); `@map` gives the *columns* the specified
// names, so the database matches the spec exactly with no application churn:
//
//   id          → id
//   createdAt   → created_date
//   updatedAt   → updated_date
//   createdById → created_by_id
//
// `created_by_id` is a plain indexed column, deliberately NOT a foreign key:
// audit and provenance must survive the deletion of the user who acted, and
// some rows are created by anonymous visitors or by the system itself. It is
// nullable because rows predating this convention have no author, and this
// project neither fabricates nor deletes data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Applications connect as `qhakaza_app`: not the owner, not a superuser, no
  // BYPASSRLS. This is what makes the policies bite.
  url       = env("DATABASE_URL")
  // Migrations connect as the owner, which correctly bypasses RLS -- the app
  // role has no rights to ALTER anything.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles
// ---------------------------------------------------------------------------

/// The four roles the platform recognises. ADVISOR sits alongside ADMIN on the
/// Command Center side: advisors run matching and concierge work but are not
/// platform administrators.
enum Role {
  ARTIST
  COLLECTOR
  ADMIN
  ADVISOR
  /// Internal Analyst. Confirmed as a fifth role, distinct from ADVISOR:
  /// analysts work Cases, evidence and research; advisors run concierge work.
  ANALYST
}

/// The publication states.
///
///   DRAFT -> SUBMITTED -> UNDER_REVIEW -> APPROVED -> COLLECTOR_READY
///        -> RELEASED_TO_AUDIENCE
///
/// plus RETURNED_FOR_INFORMATION and REJECTED, which interrupt it, and
/// RESTRICTED, PUBLIC_EDITORIAL, ARCHIVED and SUPERSEDED.
///
/// APPROVAL IS NOT PUBLICATION, AND PUBLICATION IS NOT PUBLIC. Those are three
/// different facts:
///
///   APPROVED              Qhakaza has vetted it. Nobody outside can see it.
///   COLLECTOR_READY       A collector-safe projection exists. Still nobody
///                         outside can see it - no audience holds it yet.
///   RELEASED_TO_AUDIENCE  At least one un-revoked ArtworkRelease exists. Who
///                         sees it is decided by that release, never by this
///                         column.
///   PUBLIC_EDITORIAL      Separately authorised editorial use. Requires the
///                         artist's PUBLISH_PUBLICLY permission.
///
/// The status says how far along a work is. It never says who may see it -
/// that is what ArtworkRelease is for, and RLS reads the release, not this.
///
/// PUBLISHED, SOLD, HIDDEN and LISTED are retired spellings kept because
/// PostgreSQL cannot drop an enum value. Existing rows were migrated:
/// PUBLISHED -> COLLECTOR_READY (approved, but released to nobody until
/// assigned), SOLD and HIDDEN -> ARCHIVED. Nothing writes them now.
enum ArtStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED_FOR_INFORMATION
  APPROVED
  /// Vetted and prepared for collectors, held back until released.
  COLLECTOR_READY
  /// One or more audiences hold it. The releases say which.
  RELEASED_TO_AUDIENCE
  /// Deliberately withheld - a dispute, a request, an embargo.
  RESTRICTED
  /// Authorised for editorial or brand use. Never inventory.
  PUBLIC_EDITORIAL
  REJECTED
  /// No longer in circulation. Retained, never deleted.
  ARCHIVED
  /// Replaced by a newer record of the same work.
  SUPERSEDED

  /// @deprecated see the note above
  PUBLISHED
  /// @deprecated folded into ARCHIVED
  SOLD
  /// @deprecated folded into ARCHIVED
  HIDDEN
  /// @deprecated original spelling of PUBLISHED
  LISTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

/// Which of the three collector-side journeys produced an intake.
///
/// One table rather than three near-identical ones: all three are a
/// prospective collector telling us about themselves, they are vetted by the
/// same people in the same queue, and they carry the same sensitive fields.
/// The discriminator keeps them distinguishable without forking the entity.
enum CollectorIntakeKind {
  /// "Begin Intake" — full onboarding for a new collector.
  INTAKE
  /// "Request Access" — a limited preview window, after onboarding.
  ACCESS_REQUEST
  /// "Request Membership Consideration" — for someone who cannot currently
  /// meet the membership fee and is asking to be considered anyway.
  MEMBERSHIP_CONSIDERATION
}

enum CollectorIntakeStatus {
  /// The intake form is complete; verification has not yet run.
  AWAITING_VERIFICATION
  UNDER_REVIEW
  ACCEPTED
  DECLINED
}

enum VerificationOutcome {
  PENDING
  VERIFIED
  REJECTED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  LAPSED
  DECLINED
  REVOKED
}

/// The invitation lifecycle, as specified by the handover brief:
///
///   CREATED -> SENT -> OPENED -> ACCEPTED -> COMPLETED
///
/// plus EXPIRED and CANCELLED, which can interrupt it at any point.
///
/// ISSUED and REVOKED are the ORIGINAL spellings, kept because PostgreSQL
/// cannot drop an enum value without recreating the type, and because this
/// project does not rewrite history it does not have to. Existing rows were
/// migrated ISSUED -> CREATED and REVOKED -> CANCELLED; nothing writes the old
/// two any more. Treat them as read-only synonyms if you meet them in old data.
enum InvitationStatus {
  /// The record exists and a link has been generated. Not yet emailed.
  CREATED
  /// Handed to the email layer successfully.
  SENT
  /// The recipient followed the link at least once.
  OPENED
  /// The recipient signed in and the invitation was consumed. Single-use.
  ACCEPTED
  /// Onboarding finished - the artist has a profile, or the collector a
  /// membership. The end of the happy path.
  COMPLETED
  /// Past `expiresAt` without being accepted.
  EXPIRED
  /// Withdrawn by staff before acceptance.
  CANCELLED

  /// @deprecated original spelling of CREATED
  ISSUED
  /// @deprecated original spelling of CANCELLED
  REVOKED
}

/// Why an attempt to activate a `/private/<token>` route succeeded or failed.
/// Every failure is recorded — a token being probed is a security signal.
enum ActivationOutcome {
  SUCCESS
  MISSING_TOKEN
  INVALID_TOKEN
  EXPIRED_TOKEN
  REVOKED_TOKEN
  ROLE_DENIED

  /// Turned away by the rate limiter before the token was examined.
  ///
  /// Recorded rather than dropped: sustained guessing is the single most
  /// important thing this table exists to show, and it is precisely the
  /// pattern that trips the limiter. Losing these rows would mean the log
  /// went quiet at the moment it became interesting.
  RATE_LIMITED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoteStatus {
  SUBMITTED
  IN_REVIEW
  ACTIONED
  ARCHIVED
}

enum PartnerStatus {
  PROSPECT
  ACTIVE
  DORMANT
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(COLLECTOR)
  avatar        String?
  bio           String?
  createdAt     DateTime  @default(now()) @map("created_date")
  updatedAt     DateTime  @updatedAt @map("updated_date")
  createdById   String?   @map("created_by_id")

  artist      Artist?
  orders      Order[]
  favorites   Favorite[]
  accounts    Account[]
  sessions    Session[]
  memberships Membership[]

  @@index([role])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Supply side — Vera
// ---------------------------------------------------------------------------

/// Core entity 5. Was `ArtistProfile`; renamed to match the canonical entity
/// list. The table was renamed in place, not recreated.
model Artist {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  slug        String  @unique
  statement   String?
  socials     Json?
  approved    Boolean @default(false)

  /// TWO BIOGRAPHIES, BOTH THE ARTIST'S OWN, confirmed by Qhakaza.
  ///
  /// `biographyPublic` is what may appear in a public projection. It is the
  /// ONLY one of the two that is ever eligible for release, and it still
  /// requires the artist's publication permission before it goes anywhere.
  ///
  /// `biographyInternal` is fuller and is for assessment. RLS is row-level,
  /// not column-level, so this column is inside a row the public may read for
  /// an approved artist - it is kept out of public output by the explicit
  /// field whitelist in the catalogue queries, NOT by the policy. If a new
  /// public read of Artist is ever written, it must select fields explicitly.
  biographyPublic   String?
  biographyInternal String?

  /// How the artist describes their practice: materials, process, concerns.
  /// Distinct from `statement`, which is preserved verbatim as their words
  /// about the work itself.
  practice String?

  basedIn     String?
  nationality String?
  birthYear   Int?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworks    Artwork[]
  permissions ArtistPermission[]

  // The record, in depth. Child tables throughout - see the section header.
  mediums         ArtistMedium[]
  exhibitions     ArtistExhibition[]
  representations ArtistRepresentation[]
  cvEntries       CvEntry[]
  signals         InstitutionalSignal[]
  links           ArtistLink[]
  declaredPrices  DeclaredPrice[]
  assessments     ReadinessAssessment[]

  @@index([approved])
  @@index([createdById])
}

/// Core entity 6. Was `ArtPiece`.
model Artwork {
  id          String    @id @default(cuid())
  artistId    String
  title       String
  description String
  images      String[]
  medium      String
  dimensions  String
  price       Decimal   @db.Decimal(12, 2)
  currency    String    @default("ZAR")
  status      ArtStatus @default(DRAFT)
  createdAt   DateTime  @default(now()) @map("created_date")
  updatedAt   DateTime  @updatedAt @map("updated_date")
  createdById String?   @map("created_by_id")

  artist         Artist                 @relation(fields: [artistId], references: [id], onDelete: Cascade)
  reviewRequests ArtworkReviewRequest[]
  orders         Order[]

  /// What the work is about, for matching against collector preferences.
  /// Free text rather than a fixed vocabulary: Qhakaza's language for its own
  /// artists is not a list a developer should be inventing.
  themes String[]

  // Visibility and release
  releases    ArtworkRelease[]
  suggestions MatchSuggestion[]
  permissions ArtistPermission[]

  // VERA
  evidence     Evidence[]
  claims       Claim[]
  gaps         Gap[]
  escalations  SpecialistEscalation[]
  caseLinks    CaseArtwork[]
  partyLinks   ArtworkParty[]
  exhibitions  ArtworkExhibition[]
  publications ArtworkPublication[]
  transactions ProvenanceTransaction[]
  favorites    Favorite[]
  notes        PrivateNoteSubmission[]

  /// Every figure ever declared for this work. `price` above is the current
  /// one; this is what it used to be, and who said so.
  declaredPrices DeclaredPrice[]

  @@index([artistId])
  @@index([status])
  @@index([medium])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Collector side
// ---------------------------------------------------------------------------

/// Core entity 2. Was `CollectorApplication`.
///
/// Holds **sensitive personal and financial information** — income and
/// liquid-asset bands, contact details, free text about someone's wealth.
/// Everything but name and email is optional by design. Any screen reading this
/// table is privileged; rows are never logged.
model CollectorIntake {
  id     String                @id @default(cuid())
  status CollectorIntakeStatus @default(AWAITING_VERIFICATION)
  /// Defaults to INTAKE so every row written before the three journeys were
  /// separated keeps its original meaning.
  kind   CollectorIntakeKind   @default(INTAKE)

  fullName String
  email    String
  phone    String?
  country  String?
  city     String?

  annualIncomeBand String?
  liquidAssetsBand String?

  collectingGoal   String?
  artExposure      String?
  /// Free-form rather than an enum: the medium list is marketing copy that will
  /// change without a migration, and a stale enum would reject a live option.
  preferredMediums String[]

  /// Why the applicant cannot currently meet the membership fee, in their own
  /// words. Only ever set on a MEMBERSHIP_CONSIDERATION.
  considerationNote String?
  /// What an ACCESS_REQUEST wants to preview.
  accessInterest    String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  verification CollectorVerification?
  membership   Membership?
  cases        IntelligenceCase[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([email])
  @@index([createdById])
}

/// Core entity 3. The outcome of vetting an intake. Separate from the intake so
/// the applicant's submission and the platform's judgement of it are never
/// confused, and so verification can be re-run without touching what was said.
model CollectorVerification {
  id          String              @id @default(cuid())
  intakeId    String              @unique
  outcome     VerificationOutcome @default(PENDING)
  notes       String?
  decidedAt   DateTime?
  /// The admin or advisor who decided. Not a foreign key, for the same reason
  /// `created_by_id` is not: the decision outlives the decider's account.
  decidedById String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  intake CollectorIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([outcome])
  @@index([createdById])
}

/// Core entity 1. A collector's standing on the platform.
///
/// `userId` is nullable: a membership can be granted and invited before the
/// collector has ever created an account, and is linked on activation.
model Membership {
  id        String           @id @default(cuid())
  userId    String?
  intakeId  String?          @unique
  status    MembershipStatus @default(PENDING)
  tier      String?
  startedAt DateTime?
  expiresAt DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  intake      CollectorIntake?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  invitations MemberInvitation[]
  notes       PrivateNoteSubmission[]
  audiences   AudienceMember[]
  profile     CollectorProfile?
  suggestions MatchSuggestion[]

  @@index([status])
  @@index([userId])
  @@index([createdById])
}

/// Core entity 4. The invitation that unlocks `/private/<token>`.
///
/// `tokenHash` stores a SHA-256 of the token, never the token itself: a leaked
/// database dump must not hand over working invitations. The plaintext exists
/// only in the invitation email.
/// A note written by staff, about anything.
///
/// THIS IS THE INTERNAL ADMINISTRATIVE NOTE from the handover brief, and it is
/// a THIRD concept distinct from the two that already carry the name:
///
///   PrivateNote            a prospect's RSVP survey, collector-facing
///   PrivateNoteSubmission  a member's enquiry to their advisor
///   InternalNote           this: staff writing to staff, never seen outside
///
/// None of the three was repurposed into another. They have different authors,
/// different readers and different lifetimes.
///
/// SEPARATE FROM EVIDENCE, DELIBERATELY. A note never becomes part of a
/// Collector Intelligence Case by accident: `convertedToEvidenceId` is set only
/// when an authorised user deliberately converts it. Private comments must
/// never surface in a Case simply because they were attached to the same
/// artwork.
model InternalNote {
  id String @id @default(cuid())

  /// What the note is about: "Artist", "Artwork", "CollectorIntake", "Case".
  /// A string rather than an enum so the VERA phases can attach notes to their
  /// own records without a migration.
  subjectType String
  subjectId   String

  body String

  /// Set only by a deliberate conversion. Until then the note is not evidence
  /// and must not be read as though it were.
  convertedToEvidenceId String?
  convertedAt           DateTime?
  convertedById         String?

  authorId String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  revisions InternalNoteRevision[]

  @@index([subjectType, subjectId])
  @@index([authorId])
  @@index([createdById])
}

/// The previous text of a note, kept whenever it is materially changed.
///
/// Append-only. The brief requires notes to preserve an audit history, and a
/// note that can be quietly rewritten is not a record of anything. Editing
/// writes the OLD body here first, so the chain reads backwards from the
/// current text.
model InternalNoteRevision {
  id     String @id @default(cuid())
  noteId String

  /// The body as it was before this edit.
  previousBody String
  editedById   String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  note InternalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@index([createdById])
}

/// A reviewer sending a submission back with a question.
///
/// A record rather than a status alone, because "returned for information" is
/// useless to an artist who cannot see what was asked. Kept after resolution:
/// what was asked, and when it was answered, is part of the work's history.
model ArtworkReviewRequest {
  id        String @id @default(cuid())
  artworkId String

  /// What the reviewer needs. Shown to the artist verbatim.
  request String

  requestedById String?
  resolvedAt    DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId, resolvedAt])
  @@index([createdById])
}

/// How sensitive a stored file is.
///
/// Section 22 requires that unpublished evidence and internal analysis are
/// never exposed through client-facing permissions. This is the per-file half
/// of that: RLS decides who may read the ROW, and this decides how the file
/// behind it may be served.
enum FileConfidentiality {
  /// Servable to anyone. Released artwork photographs.
  PUBLIC
  /// Staff only. Evidence documents, specialist reports, correspondence.
  INTERNAL
  /// Staff with a specific need. Named parties, legal material.
  CONFIDENTIAL
}

enum MediaAssetStatus {
  /// A signed upload URL was issued; the browser has not confirmed the upload.
  PENDING
  /// The object is in the bucket.
  STORED
  /// Withdrawn from view. The object is NOT deleted - see the model comment.
  DELETED
}

/// Every file the platform stores, whatever it belongs to.
///
/// One table for artwork photographs, evidence documents, specialist reports
/// and correspondence, because section 23 asks the same seven questions of all
/// of them: who uploaded it, when, under what name, of what type and size,
/// against which record, and how confidential.
///
/// POLYMORPHIC BY SUBJECT rather than one nullable foreign key per owner. The
/// VERA phases add several more owners, and a table that grows a column per
/// owner type ends up mostly nulls.
///
/// NOTHING IS EVER HARD-DELETED. Section 23 requires files to remain
/// retrievable even when the visible record changes, so `status` moves to
/// DELETED and the object stays in the bucket. A file that has been referenced
/// in an assessment must still be produceable afterwards.
model MediaAsset {
  id String @id @default(cuid())

  /// What this file belongs to: "Artwork", "Evidence", "SpecialistOpinion"...
  /// Deliberately a string, not an enum: the VERA phases add subjects, and a
  /// new one should not need a migration.
  subjectType String
  subjectId   String

  /// Where the bytes are. Together these are the storage location.
  bucket      String
  storagePath String @unique

  /// What the person called it. Kept separate from `storagePath`, which is
  /// generated - two artists both uploading "final.jpg" must not collide.
  originalFilename String
  contentType      String
  sizeBytes        Int

  status          MediaAssetStatus    @default(PENDING)
  confidentiality FileConfidentiality @default(INTERNAL)

  /// WHAT THE DOCUMENT IS. Defect D2 in the Phase 0 audit: this table recorded
  /// a file's size and MIME type but not whether it was a certificate, a
  /// condition report or a passport scan. Nullable because existing rows
  /// predate the taxonomy and guessing their type would be inventing a fact.
  documentTypeId String?

  /// Ordering within its subject, for a gallery of several images.
  position Int @default(0)

  uploadedById String?
  uploadedAt   DateTime?
  deletedAt    DateTime?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  documentType DocumentType?  @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  /// Everything this file is attached to. See DocumentLink for why the two
  /// columns above are no longer the whole answer.
  links        DocumentLink[]

  @@index([subjectType, subjectId, status])
  @@index([status, createdAt])
  @@index([documentTypeId])
  @@index([uploadedById])
  @@index([createdById])
}

/// Who an invitation can be addressed to.
///
/// A TABLE, not an enum, because the brief requires the type list to stay
/// extensible. Adding "Institution" or "Advisor" later must be a row, not a
/// migration and a redeploy.
model InvitationRecipientType {
  id         String  @id @default(cuid())
  /// Stable machine name. Referenced in code; never shown to a user.
  slug       String  @unique
  label      String
  /// The role the accepted account is given. Kept here so the mapping from
  /// invitation to role is data rather than a switch statement.
  grantsRole Role
  /// Retired types stop being offered without breaking the rows that used them.
  active     Boolean @default(true)
  ordering   Int     @default(0)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  invitations MemberInvitation[]

  @@index([active, ordering])
  @@index([createdById])
}

model MemberInvitation {
  id              String           @id @default(cuid())
  /// Null for artist invitations: an artist has no membership to attach to.
  membershipId    String?
  /// Null only for rows predating the recipient-type table.
  recipientTypeId String?
  recipientName   String?
  email           String
  tokenHash       String           @unique
  status          InvitationStatus @default(CREATED)
  expiresAt       DateTime

  /// The lifecycle timestamps. Each is set once, by the transition that earns
  /// it, and never cleared - the row is its own history.
  sentAt      DateTime?
  openedAt    DateTime?
  acceptedAt  DateTime?
  completedAt DateTime?
  revokedAt   DateTime?

  /// Who pressed send, which is not always who created the record.
  sentById         String?
  /// The account this invitation produced. The single-use guarantee: an
  /// invitation with this set has already made its user and cannot make another.
  acceptedByUserId String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  membership    Membership?              @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  recipientType InvitationRecipientType? @relation(fields: [recipientTypeId], references: [id], onDelete: SetNull)
  attempts      ActivationAttempt[]

  @@index([status, expiresAt])
  @@index([email])
  @@index([recipientTypeId, status])
  @@index([createdById])
}

/// Core entity 12. Every attempt to use a private token, successful or not.
///
/// Stores a fingerprint of the presented token rather than the token, so this
/// log can be read freely during an investigation without becoming a source of
/// working credentials.
model ActivationAttempt {
  id               String            @id @default(cuid())
  invitationId     String?
  tokenFingerprint String
  outcome          ActivationOutcome
  ipAddress        String?
  userAgent        String?

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  invitation MemberInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([outcome, createdAt])
  @@index([tokenFingerprint])
  @@index([createdById])
}

/// Core entity 8. A private note from a collector to their advisor — an
/// enquiry, a question about a work, a request for a viewing.
model PrivateNoteSubmission {
  id           String     @id @default(cuid())
  membershipId String?
  artworkId    String?
  subject      String
  body         String
  status       NoteStatus @default(SUBMITTED)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  artwork    Artwork?    @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([membershipId])
  @@index([createdById])
}

/// The Private Note — an RSVP-style survey from a *prospective* collector.
///
/// A SEPARATE ENTITY from `PrivateNoteSubmission`, despite the similar name,
/// and deliberately so:
///
///   PrivateNoteSubmission  a member writing to their advisor about a work.
///                          Requires a Membership. Already live and tested.
///   PrivateNote            someone who is not yet a member telling us what
///                          they collect and how we could serve them.
///
/// Folding the second into the first would have meant changing what an existing,
/// working table means — and its `membershipId` has nowhere to point for a
/// prospect. Flagged rather than assumed: if the founder considers these one
/// concept, they should be merged deliberately, not by side effect.
model PrivateNote {
  id       String @id @default(cuid())
  fullName String
  email    String

  /// Interests. Free-form arrays for the same reason `preferredMediums` is:
  /// these lists are editorial and will change without a migration.
  mediums  String[]
  regions  String[]
  subjects String?

  /// Preferences.
  acquisitionPace String?
  budgetBand      String?
  advisoryStyle   String?
  contactStyle    String?

  /// How Qhakaza can serve them.
  building     String?
  frustrations String?
  goodOutcome  String?

  /// Explicit permission to be contacted about what they wrote.
  mayContact Boolean @default(false)

  status NoteStatus @default(SUBMITTED)

  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")
  createdById String?  @map("created_by_id")

  @@index([status, createdAt])
  @@index([email])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Editorial and partners
// ---------------------------------------------------------------------------

/// Core entity 7.
model NewsArticle {

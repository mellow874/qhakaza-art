{
  "name": "@qhakaza/shared-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "check:env": "tsx scripts/check-env.ts",
    "export:schema": "tsx scripts/export-schema.ts",
    "verify": "tsx scripts/verify-database.ts",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "generate:rls": "tsx scripts/generate-rls.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}

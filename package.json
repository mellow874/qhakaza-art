{
  "name": "qhakaza-art",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run typecheck && npm run test",
    "db:up": "tsx scripts/db.ts up",
    "db:down": "tsx scripts/db.ts down",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "prisma migrate dev --schema packages/shared-db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/shared-db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/shared-db/prisma/schema.prisma",
    "db:seed": "tsx packages/shared-db/prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --schema packages/shared-db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/shared-db/prisma/schema.prisma",
    "vera": "npm run dev --workspace @qhakaza/vera",
    "test:workspace": "npm test && npm test --workspace @qhakaza/vera && npm test --workspace @qhakaza/collector && npm test --workspace @qhakaza/command-center",
    "typecheck:workspace": "npm run typecheck && npm run typecheck --workspace @qhakaza/vera && npm run typecheck --workspace @qhakaza/collector && npm run typecheck --workspace @qhakaza/command-center",
    "e2e:workspace": "npm run test:e2e --workspace @qhakaza/vera && npm run test:e2e --workspace @qhakaza/collector && npm run test:e2e --workspace @qhakaza/command-center",
    "collector": "npm run dev --workspace @qhakaza/collector",
    "command-center": "npm run dev --workspace @qhakaza/command-center",
    "build:all": "npm run build --workspace @qhakaza/vera && npm run build --workspace @qhakaza/collector && npm run build --workspace @qhakaza/command-center",
    "postinstall": "prisma generate --schema packages/shared-db/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx packages/shared-db/prisma/seed.ts",
    "schema": "packages/shared-db/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@qhakaza/shared-auth": "*",
    "@qhakaza/shared-db": "*",
    "@qhakaza/shared-ui": "*",
    "bcryptjs": "^3.0.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

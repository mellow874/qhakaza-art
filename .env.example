# Copy to .env and fill in. .env is gitignored.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5432/qhakaza_art?schema=public"
# Used by the test suite — separate database, wiped freely.sc
TEST_DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5433/qhakaza_art_test?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


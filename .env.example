# Qhakaza Art Collective — environment template
#
# THIS FILE IS COMMITTED AND PUBLIC. It documents which variables exist; it must
# never contain a real value. Copy it to `.env` (gitignored) and fill that in.
#
#   cp .env.example .env
#   npm run check:env -w packages/shared-db
#
# Every value below is read through packages/shared-db/src/env.ts. Nothing reads
# process.env for a credential directly, so this list is complete.

# ===========================================================================
# DATABASE
# ===========================================================================
#
# TWO URLS, TWO IDENTITIES. This is the platform's main security control and
# the easiest thing to get quietly wrong.
#
#   DATABASE_URL        the application, as `qhakaza_app`
#                       NOSUPERUSER, NOBYPASSRLS, not the table owner.
#                       This is what makes the 53 RLS policies actually apply.
#
#   DIRECT_DATABASE_URL migrations, as the database owner
#                       Bypasses RLS, which is correct — the app role has no
#                       rights to ALTER anything.
#
# Pointing DATABASE_URL at the owner disables every policy in the database
# while leaving the site working perfectly. `npm run verify -w packages/shared-db`
# tests for this specifically.

# --- Local development (matches docker-compose.yml) ---
DATABASE_URL="postgresql://qhakaza_app:qhakaza_app@localhost:5432/qhakaza_art?schema=public"
DIRECT_DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5432/qhakaza_art?schema=public"

# --- Test suite: a separate, disposable database on its own port ---
# Kept distinct so a misconfigured run cannot reach real data.
TEST_DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5433/qhakaza_art_test?schema=public"

# --- Production (Supabase) ---
# Set these in Vercel's environment settings, NOT here. Shown for reference:
#
#   DATABASE_URL         transaction pooler, port 6543, user qhakaza_app
#     postgresql://qhakaza_app:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
#   DIRECT_DATABASE_URL  session pooler, port 5432, user postgres.PROJECTREF
#     postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Supabase also offers a "direct connection" on db.PROJECTREF.supabase.co — it
# is IPv6-only and unreachable from most CI runners. Use the session pooler.
#
# The qhakaza_app password is set by the migration to a known default so local
# setup needs no configuration. Change it in production:
#   ALTER ROLE qhakaza_app WITH PASSWORD '…';
# See MIGRATION_RUNBOOK.md step 4.

# ===========================================================================
# AUTH
# ===========================================================================
# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# The site's own public URL. http://localhost:3001 / :3002 / :3003 in dev,
# the deployed origin in production.
AUTH_URL="http://localhost:3001"

# --- Google OAuth (optional) ---
# The sign-in button stays hidden while these are empty, so leaving them blank
# is a supported state rather than a broken one.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================================================
# CROSS-SITE LINKS
# ===========================================================================
# Vera is a separate deployment on a different origin, so the collector site
# cannot link to it with a path. Public: inlined into the client bundle.
NEXT_PUBLIC_VERA_URL="http://localhost:3001"

# ===========================================================================
# NOT YET CONNECTED
# ===========================================================================
# Listed so the shape is agreed before the credentials exist.
#
# --- Email (Phase 2) ---
# Sending address is desk@qhakazaartcollective.co.za. Until a key is present the
# platform logs outgoing mail and shows the invitation link in the admin UI
# instead, so nothing is blocked.
# EMAIL_PROVIDER="resend"           # resend | smtp | logging (default: logging)
# EMAIL_FROM="Qhakaza Art Collective <desk@qhakazaartcollective.co.za>"
# RESEND_API_KEY=""
# Requires SPF, DKIM and return-path DNS records on qhakazaartcollective.co.za.
#
# --- Object storage (Phase 3) ---
# Artwork images are external URLs today; there is no storage integration yet.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""      # server only — never expose to the browser
# SUPABASE_STORAGE_BUCKET="artwork"
#
# --- Background audio (Phase 8) ---
# Swappable without a code change once the licensed track exists.
# NEXT_PUBLIC_AUDIO_TRACK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# COLLECTOR PLATFORM — public shell + invite-only concierge (port 3002)
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` in this folder.
#
# THE THREE APPS SHARE EVERYTHING EXCEPT `AUTH_URL`.
# DATABASE_URL, DIRECT_DATABASE_URL and AUTH_SECRET must be IDENTICAL in Vera,
# the Collector Platform and the Command Center. One database, one signing key.
# Only AUTH_URL differs, because each app answers on its own address.

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (`npm run db:up` from the repo root).
#
# `qhakaza_app` is deliberately NOT the owner: it is the role Row-Level Security
# actually constrains. Point this at the owner and every policy is silently
# bypassed — see docs/RLS.md.
DATABASE_URL="postgresql://qhakaza_app:qhakaza_app@localhost:5432/qhakaza_art?schema=public"

# The owner. Used ONLY by `prisma migrate` and by the seed — never by the app.
DIRECT_DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5432/qhakaza_art?schema=public"

# ── Supabase (or Neon) instead of local ──────────────────────────────────────
# Swap the two lines above for these. Nothing else changes.
#
#   DATABASE_URL         → Supabase "Transaction pooler"  (port 6543)
#   DIRECT_DATABASE_URL  → Supabase "Direct connection"   (port 5432)
#
# Transaction pooling, not session: withActor() sets the actor with
# set_config(..., true), which is transaction-scoped.
#
# DATABASE_URL="postgresql://qhakaza_app:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_DATABASE_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate once with `npx auth secret`, then use the SAME value in all three
# apps. A session minted by one app is unreadable by the others if these differ.
AUTH_SECRET=""

# This app's own origin. Wrong value = sign-in redirects off-site.
AUTH_URL="http://localhost:3002"

# ── Google sign-in (OPTIONAL) ────────────────────────────────────────────────
# Leave blank and the "Continue with Google" button is not rendered at all.
# Email and password sign-in works either way.
# Redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cross-site link ──────────────────────────────────────────────────────────
# Vera is a separate application on its own domain, so the collector footer's
# "Artist Intelligence" link cannot be a path. Set this to Vera's public URL.
NEXT_PUBLIC_VERA_URL="http://localhost:3001"

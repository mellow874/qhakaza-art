# Vera — public artist website
#
# One database, three apps: this connection string is the SAME one the
# Collector Platform and the Command Center use. Vera is separated by role and
# by RLS, not by having a database of its own.

DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5432/qhakaza_art?schema=public"

# Auth.js. Generate the secret with `npx auth secret`.
AUTH_SECRET=""
AUTH_URL="http://localhost:3001"

# Google OAuth (optional).
# Redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

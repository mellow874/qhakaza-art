# Command Center — admin and advisor hub. The only bridge between the two sites.
#
# One database, three apps: this connection string is the SAME one the
# Collector Platform and the Command Center use. This app is separated by role, token
# and RLS, not by having a database of its own.

DATABASE_URL="postgresql://qhakaza:qhakaza@localhost:5432/qhakaza_art?schema=public"

# Auth.js. Generate the secret with `npx auth secret`.
AUTH_SECRET=""
AUTH_URL="http://localhost:3003"

# Google OAuth (optional).
# Redirect URI: http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
